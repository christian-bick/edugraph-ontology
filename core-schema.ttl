@prefix : <http://edugraph.io/edu#> .
@prefix edu: <http://edugraph.io/edu#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://edugraph.io/edu#> .

<http://edugraph.io/edu#> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://edugraph.io/edu#constrainedBy
edu:constrainedBy rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  owl:inverseOf edu:constrains ;
                  rdfs:domain edu:CompetencyEntity ;
                  rdfs:range edu:CompetencyEntity ;
                  rdfs:isDefinedBy "A is constrained by B when the requirements represented by B restrict or determine compatibility with A." ;
                  rdfs:comment "This is the inverse direction of constrains." .


###  http://edugraph.io/edu#constrains
edu:constrains rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain edu:CompetencyEntity ;
               rdfs:range edu:CompetencyEntity ;
               rdfs:isDefinedBy "A constrains B when the requirements represented by A restrict or determine compatibility with B." ;
               rdfs:comment "These relations concern constraints on the described concepts, rather than teaching order." .


###  http://edugraph.io/edu#contradictedBy
edu:contradictedBy rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf edu:constrainedBy ;
                   owl:inverseOf edu:contradicts ;
                   rdfs:domain edu:CompetencyEntity ;
                   rdfs:range edu:CompetencyEntity ;
                   rdfs:isDefinedBy "A is contradicted by B when the requirements represented by B and A conflict, wholly or partially, at the level of the described concepts." ;
                   rdfs:comment "This is the inverse direction of contradicts. A conflict between concepts need not exclude every shared instance." .


###  http://edugraph.io/edu#contradicts
edu:contradicts rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf edu:constrains ;
                rdfs:domain edu:CompetencyEntity ;
                rdfs:range edu:CompetencyEntity ;
                rdfs:isDefinedBy "A contradicts B when the requirements represented by A and B conflict, wholly or partially. The conflict is interpreted at the level of the described concepts, rather than requiring every possible instance to be mutually exclusive." ;
                rdfs:comment "NumbersSmaller10 and NumbersLarger10 describe opposing inclusive number ranges. Both include numbers of magnitude 10, as shared endpoints are useful in educational progression. Their contradiction concerns the ranges themselves, not exclusion of the shared boundary value." .


###  http://edugraph.io/edu#expandedBy
edu:expandedBy rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf edu:expands ;
               rdfs:domain edu:CompetencyEntity ;
               rdfs:range edu:CompetencyEntity ;
               rdfs:isDefinedBy "A is expanded by B when understanding B builds on understanding A through a conceptual extension." ;
               rdfs:comment "This is the inverse direction of expands." .


###  http://edugraph.io/edu#expands
edu:expands rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain edu:CompetencyEntity ;
            rdfs:range edu:CompetencyEntity ;
            rdfs:isDefinedBy "A expands B when understanding A builds on understanding B through a conceptual extension." ;
            rdfs:comment "Multiplication expands Addition. A conceptual relationship does not establish a mandatory teaching order for every learner." .


###  http://edugraph.io/edu#hasPart
edu:hasPart rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf edu:structuredBy ;
            owl:inverseOf edu:partOf ;
            rdfs:domain owl:Thing ;
            rdfs:range owl:Thing ;
            rdfs:isDefinedBy "A has part B when B is a constituent of the whole or field represented by A." ;
            rdfs:comment "CircularShapes has part Circle. Membership does not make a constituent interchangeable with its containing field." .


###  http://edugraph.io/edu#impliedBy
edu:impliedBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf edu:constrainedBy ;
              owl:inverseOf edu:implies ;
              rdfs:domain edu:CompetencyEntity ;
              rdfs:range edu:CompetencyEntity ;
              rdfs:isDefinedBy "A is implied by B when the truth of B logically guarantees the truth of A." ;
              rdfs:comment "This is the inverse direction of implies." .


###  http://edugraph.io/edu#implies
edu:implies rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf edu:constrains ;
            rdfs:domain edu:CompetencyEntity ;
            rdfs:range edu:CompetencyEntity ;
            rdfs:isDefinedBy "A implies B when the truth of A logically guarantees the truth of B." ;
            rdfs:comment "a magnitude at most 10 is also at most 20. The implication concerns truth rather than teaching order." .


###  http://edugraph.io/edu#integratedBy
edu:integratedBy rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf edu:integrates ;
                 rdfs:domain edu:CompetencyEntity ;
                 rdfs:range edu:CompetencyEntity ;
                 rdfs:isDefinedBy "A is integrated by B when A is used as a component in constructing or applying B." ;
                 rdfs:comment "This is the inverse direction of integrates." .


###  http://edugraph.io/edu#integrates
edu:integrates rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain edu:CompetencyEntity ;
               rdfs:range edu:CompetencyEntity ;
               rdfs:isDefinedBy "A integrates B when B is used as a component in constructing or applying A." ;
               rdfs:comment "Multiplication integrates Iteration." .


###  http://edugraph.io/edu#invertedBy
edu:invertedBy rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf edu:expandedBy ;
               owl:inverseOf edu:inverts ;
               rdfs:domain edu:CompetencyEntity ;
               rdfs:range edu:CompetencyEntity ;
               rdfs:isDefinedBy "A is inverted by B when B extends A by reversing its underlying operation or conceptual relationship." ;
               rdfs:comment "This is the inverse direction of inverts." .


###  http://edugraph.io/edu#inverts
edu:inverts rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf edu:expands ;
            rdfs:domain edu:CompetencyEntity ;
            rdfs:range edu:CompetencyEntity ;
            rdfs:isDefinedBy "A inverts B when A extends B by reversing its underlying operation or conceptual relationship." ;
            rdfs:comment "Subtraction inverts Addition. The authored direction does not declare the property symmetric." .


###  http://edugraph.io/edu#involvedBy
edu:involvedBy rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf edu:involves ;
               rdfs:domain edu:CompetencyDescriptor ;
               rdfs:range edu:CompetencyEntity ;
               rdfs:isDefinedBy "A is involved by B when descriptor A is included in the description of competency entity B." ;
               rdfs:comment "This is the inverse direction of involves." .


###  http://edugraph.io/edu#involves
edu:involves rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain edu:CompetencyEntity ;
             rdfs:range edu:CompetencyDescriptor ;
             rdfs:isDefinedBy "A involves B when competency entity A is described by competency descriptor B." ;
             rdfs:comment "a competency concerning multiplication with integers can involve Multiplication and IntegerNumbers. Descriptors in one description apply together; no fixed count or required dimension is imposed." .


###  http://edugraph.io/edu#partOf
edu:partOf rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf edu:structures ;
           rdfs:domain owl:Thing ;
           rdfs:range owl:Thing ;
           rdfs:isDefinedBy "A is part of B when A is a constituent of the whole or field represented by B." ;
           rdfs:comment "Circle is part of CircularShapes. This relation expresses composition without capability inheritance." .


###  http://edugraph.io/edu#specializedBy
edu:specializedBy rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf edu:structuredBy ;
                  owl:inverseOf edu:specializes ;
                  rdfs:domain owl:Thing ;
                  rdfs:range owl:Thing ;
                  rdfs:isDefinedBy "A is specialized by B when B is a narrower form of the same concept that preserves A's defining meaning." ;
                  rdfs:comment "This is the inverse direction of specializes." .


###  http://edugraph.io/edu#specializes
edu:specializes rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf edu:structures ;
                rdfs:domain owl:Thing ;
                rdfs:range owl:Thing ;
                rdfs:isDefinedBy "A specializes B when A is a narrower form of the same concept and preserves B's defining meaning." ;
                rdfs:comment "Square specializes Rectangle. A claim of the narrower concept supports the broader claim; transferring other relations requires its own inference rule." .


###  http://edugraph.io/edu#structuredBy
edu:structuredBy rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf edu:structures ;
                 rdfs:domain owl:Thing ;
                 rdfs:range owl:Thing ;
                 rdfs:isDefinedBy "A is structured by B when B is a constituent or narrower specialization within A's structural organization." ;
                 rdfs:comment "This is the inverse direction of structures and groups hasPart and specializedBy for navigation." .


###  http://edugraph.io/edu#structures
edu:structures rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain owl:Thing ;
               rdfs:range owl:Thing ;
               rdfs:isDefinedBy "A structures B when A relates to B as a constituent or as a narrower specialization within the ontology's structural organization." ;
               rdfs:comment "Use partOf or specializes to state which relationship holds. Combined structural navigation does not by itself establish capability inheritance." .


###  http://edugraph.io/edu#translatedBy
edu:translatedBy rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf edu:integratedBy ;
                 owl:inverseOf edu:translates ;
                 rdfs:domain edu:CompetencyEntity ;
                 rdfs:range edu:CompetencyEntity ;
                 rdfs:isDefinedBy "A is translated by B when B represents A through a different form or perspective." ;
                 rdfs:comment "This is the inverse direction of translates." .


###  http://edugraph.io/edu#translates
edu:translates rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf edu:integrates ;
               rdfs:domain edu:CompetencyEntity ;
               rdfs:range edu:CompetencyEntity ;
               rdfs:isDefinedBy "A translates B when A represents B through a different form or perspective, using B as a component of that representation." ;
               rdfs:comment "BaseTenBlocks translates Base10. The authored direction does not declare the property symmetric." .


#################################################################
#    Classes
#################################################################

###  http://edugraph.io/edu#Ability
edu:Ability rdf:type owl:Class ;
            rdfs:subClassOf edu:CompetencyDescriptor ;
            rdfs:isDefinedBy "A trainable cognitive performance or mental capability usable across subjects." ;
            rdfs:comment "reasoning from premises, interpreting information, or carrying out a procedure. A content annotation describes a demand or demonstrated performance, not a particular learner's mastery." .


###  http://edugraph.io/edu#Area
edu:Area rdf:type owl:Class ;
         rdfs:subClassOf edu:CompetencyDescriptor ;
         rdfs:isDefinedBy "A reusable domain of knowledge, concept, relationship, or activity being learned or applied." ;
         rdfs:comment "multiplication, knowledge of circles, or measuring length." .


###  http://edugraph.io/edu#CompetencyDescription
edu:CompetencyDescription rdf:type owl:Class ;
                          rdfs:subClassOf edu:CompetencyEntity ;
                          rdfs:isDefinedBy "A competency entity described through its involved descriptors." ;
                          rdfs:comment "a description combining an activity, a cognitive demand, and a numeric context. Such a combination is illustrative; the ontology requires no particular dimension or descriptor count." .


###  http://edugraph.io/edu#CompetencyDescriptor
edu:CompetencyDescriptor rdf:type owl:Class ;
                         rdfs:subClassOf edu:CompetencyEntity ;
                         rdfs:isDefinedBy "A reusable concept, context, or performance used to describe a competency." ;
                         rdfs:comment "Area, Scope, and Ability are the descriptor dimensions. Organizational descriptors support navigation; their existence does not make them eligible for direct content labeling." .


###  http://edugraph.io/edu#CompetencyEntity
edu:CompetencyEntity rdf:type owl:Class ;
                     rdfs:subClassOf owl:Thing ;
                     rdfs:isDefinedBy "An entity participating in the expression or description of competencies." ;
                     rdfs:comment "Competency descriptions and their descriptors are both competency entities." .


###  http://edugraph.io/edu#Scope
edu:Scope rdf:type owl:Class ;
          rdfs:subClassOf edu:CompetencyDescriptor ;
          rdfs:isDefinedBy "A reusable context or condition that shapes how knowledge or a performance is applied." ;
          rdfs:comment "a numeric range, a representation, a measurement unit, or a required proof method. A Scope need not increase difficulty." .


