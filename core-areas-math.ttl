@prefix : <http://edugraph.io/edu/>.
@prefix edu: <http://edugraph.io/edu#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<http://edugraph.io/edu/> a owl:Ontology;
    owl:imports <http://edugraph.io/edu#>.
:AbsoluteNumberMagnitude a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The nonnegative magnitude of a rational number independently of its sign, represented as its distance from zero on the number line.";
    edu:expands :ZeroConcept;
    edu:partOf :NumberSense;
    edu:translates :DistanceCalculation.
:AcuteAngle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "An angle greater than zero degrees and less than 90 degrees.";
    rdfs:comment "For example: angles measuring 30 degrees or 60 degrees.";
    edu:specializes :AngleConcept.
:AcuteTriangle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A triangle in which all three interior angles are acute angles.";
    edu:integrates :AcuteAngle;
    edu:specializes :Triangle.
:Addition a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Combining numerical quantities to determine their total.";
    rdfs:comment "For example: combining 3 and 4 to obtain 7.";
    edu:expands :Sum;
    edu:partOf :BaseOperations;
    edu:translates :UnionOfCollections.
:AdditionCompensation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Adding after changing one addend to a convenient nearby value and compensating for that change in the result or other addend.";
    edu:expands :Addition;
    edu:partOf :IntegerStrategies.
:AdditionCountingOn a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Adding by starting from one addend and counting forward by the amount of the other addend.";
    edu:expands :Addition, :Increment;
    edu:partOf :IntegerStrategies.
:AdditionMakeTen a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Adding by decomposing an addend so that another addend first forms ten or a larger power-of-ten landmark.";
    edu:expands :Addition, :PlaceValue;
    edu:partOf :IntegerStrategies.
:AdditionNearDoubles a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Adding near-equal addends by using a known double and adjusting by their difference.";
    edu:expands :Addition;
    edu:partOf :IntegerStrategies.
:AdditionPlaceValuePartitioning a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Adding by decomposing addends into place-value parts, combining corresponding parts, and recomposing the sum.";
    edu:expands :Addition, :PlaceValue;
    edu:partOf :IntegerStrategies.
:AdditionStandardAlgorithm a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The conventional base-ten addition algorithm that operates by aligned place values and records any required regrouping across places.";
    edu:expands :AdditionPlaceValuePartitioning, :IntegerRegrouping;
    edu:partOf :IntegerStrategies.
:AdjacentAngles a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Two angles that share a common vertex and a common side but do not overlap.";
    edu:partOf :AngleRelations.
:Algebra a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of mathematical relationships expressed through symbols for quantities, together with the rules for manipulating those expressions.";
    rdfs:comment "For example: representing an unknown quantity with a variable, or solving an equation that relates several quantities.".
:Analysis a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of limits, continuity, and the behavior of functions and infinite processes.";
    rdfs:comment "For example: investigating convergence of a sequence, differentiating a function, or examining an infinite series.".
:AngleCalculation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining the magnitude of an angle from given measurements and geometric relationships.";
    rdfs:comment "For example: finding a triangle's missing angle from its other two angles.";
    edu:expands :AngleConcept;
    edu:integrates :TrigonometricRelations;
    edu:partOf :GeometricCalculations.
:AngleConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The amount of rotation or divergence between two intersecting rays, lines or planes.";
    edu:expands :ArchConcept, :IntersectionRelation;
    edu:partOf :GeometricConcepts.
:AngleRelations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of relationships between angles based on their positions or measures.";
    rdfs:comment "For example: adjacent angles, complementary angles, or opposite angles formed by intersecting lines.";
    edu:expands :AngleConcept;
    edu:partOf :GeometricRelations.
:ArchConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A continuous portion of the circumference of a circle or any other curved line.";
    edu:expands :Circle, :RatioInterpretation;
    edu:partOf :GeometricConcepts.
:AreaCalculation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The calculation of the extent or measurement of a surface.";
    edu:expands :LengthCalculation, :PlaneConcept;
    edu:partOf :GeometricCalculations.
:Arithmetic a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of numerical values and the operations and relationships used to calculate with them.";
    rdfs:comment "For example: addition, subtraction, multiplication, and division.".
:ArithmeticEvaluation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The structured formulation and evaluation of numerical statements through the combination of values and operations.";
    edu:partOf :Arithmetic.
:ArithmeticOperations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Mathematical operations that combine or transform numerical values according to defined rules.";
    rdfs:comment "For example: addition, subtraction, multiplication, division, exponentiation, or root extraction.";
    edu:partOf :Arithmetic.
:ArithmeticSpaces a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of number systems, their properties, and the representations used to express and operate on their values.";
    rdfs:comment "For example: integers, rational numbers written as fractions, and numbers written in decimal notation.";
    edu:partOf :Arithmetic.
:AssociativeLaw a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The mathematical principle stating that the way in which numbers are grouped by parentheses does not change their sum or product.";
    edu:partOf :MathematicalLaws.
:BaseOperations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The foundational application of mathematical rules and procedures to perform primary calculations through the core actions of addition, subtraction, multiplication, and division.";
    edu:partOf :ArithmeticOperations.
:Calculus a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The branch of mathematics that provides tools for analyzing rates of change and accumulation. It deals with instantaneous rates of change that affect the slopes of curves, as well as with accumulation that affect areas under curves.".
:CartesianPlane a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A two-dimensional plane defined by a horizontal axis and a vertical axis intersecting at a right angle.";
    edu:expands :PlaneConcept;
    edu:partOf :GeometricVisualization.
:ChordCenterRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The relationship stating that a perpendicular line drawn from the center of a circle to a chord bisects the chord into two equal parts.";
    edu:expands :LineSegment, :PerpendicularityRelation;
    edu:partOf :CircleRelations.
:Circle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Knowledge of complete circles as closed curves whose points are equally distant from a center, including the circular regions they enclose.";
    edu:expands :CircularShapeDrawing;
    edu:partOf :CircularShapes.
:CircleRelations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of spatial and quantitative relationships among the elements of a circle.";
    rdfs:comment "For example: relating a radius to a diameter, a chord to the center, or a tangent to the radius at its point of contact.";
    edu:expands :Circle;
    edu:partOf :GeometricRelations.
:CircularShapeDrawing a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Creating drawings or models of complete circles and figures formed from portions of circles.";
    rdfs:comment "For example: drawing a circle with a compass, or constructing a semicircular outline.";
    edu:partOf :SpatialModelling.
:CircularShapes a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The field of knowledge concerning complete circles and plane figures formed from portions of circles, including their boundaries, properties, and relationships.";
    rdfs:comment "For example: complete circles, half circles, and quarter circles. These are distinct concepts within the field; a physical piece of a circle does not make its concept a specialization of the complete-circle concept.";
    edu:partOf :TwoDimensionalObjects.
:CircumferenceCalculation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Calculating the length of a circle's boundary.";
    rdfs:comment "For example: calculating a circle's circumference from its radius using 2πr.";
    edu:expands :Circle, :Pi, :RadiusDiameterRelation;
    edu:specializes :PerimeterCalculation.
:CollectionSense a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Intuitive understanding of how objects form collections and how collections relate through grouping and quantity.";
    rdfs:comment "For example: recognizing a group as a whole, identifying a subgroup, or comparing two collections visually.";
    edu:partOf :IntuitiveMathematics.
:CommutativeLaw a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The mathematical principle stating that the order in which numbers are added or multiplied does not change their sum or product.";
    edu:expands :Addition, :Multiplication;
    edu:partOf :MathematicalLaws.
:ComplementaryAngles a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Two angles whose sum is exactly 90 degrees.";
    edu:partOf :AngleRelations.
:CompositeNumbers a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study and classification of whole numbers greater than 1 that have more than two positive factors; equivalently, numbers divisible by a positive whole number other than 1 and themselves.";
    edu:contradicts :PrimeNumbers;
    edu:expands :FactorsAndMultiples;
    edu:partOf :Factorization.
:ComputationalMathematics a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The branch of mathematics that involves the development and application of mathematical methods and algorithms for solving problems using computers.".
:Cone a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A three-dimensional geometric shape that tapers smoothly from a flat base to a point called the apex or vertex.";
    edu:expands :Circle, :Triangle;
    edu:partOf :ThreeDimensionalObjects.
:CongruenceRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The relationship between geometric figures that have the exact same size and shape.";
    edu:expands :ShapeConservation;
    edu:partOf :ShapeEquivalenceRelations;
    edu:translates :ShapeRotationConservation.
:CoordinateAxes a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The horizontal (x-axis) and vertical (y-axis) number lines that intersect at right angles to form the Cartesian plane.";
    edu:partOf :CartesianPlane;
    edu:translates :Numeration.
:CoordinateDistance a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The calculation of the straight-line distance between two points on the Cartesian plane using their coordinates.";
    edu:expands :PointPlotting;
    edu:partOf :GeometricVisualization.
:Cosine a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The trigonometric function that is equal to the ratio of the side adjacent to an acute angle (in a right-angled triangle) to the hypotenuse.";
    edu:partOf :TrigonometricRelations.
:Cube a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A solid geometric figure that has six congruent square faces where each pair of opposite faces is parallel.";
    edu:expands :Square;
    edu:specializes :RectangularPrism.
:Cylinder a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A three-dimensional solid consisting of two parallel circular bases connected by a curved surface.";
    edu:expands :Circle, :Rectangle;
    edu:partOf :ThreeDimensionalObjects.
:DecimalArithmetic a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding and operating on rational numbers expressed in base-ten positional notation with decimal places.";
    rdfs:comment "For example: adding aligned decimal values, rounding a decimal, or interpreting equivalent decimal representations.";
    edu:expands :NumerationWithDecimals;
    edu:partOf :RationalArithmetic.
:DecimalDivisorShift a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A decimal-division strategy that multiplies both the dividend and divisor by the same power of ten until the divisor is an integer, preserving the quotient while making the division easier to perform.";
    edu:expands :Division, :PlaceValue;
    edu:partOf :DecimalStrategies.
:DecimalEquivalence a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The rules and procedures for identifying or establishing the equality between different representations of the same rational value, specifically between fractions and their base-10 positional notation or between decimals with varying digits at subsequent negative powers of ten that maintain the same magnitude.";
    edu:expands :FractionEquivalence;
    edu:partOf :DecimalArithmetic.
:DecimalNotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The symbols and conventions used to write numbers in base-ten positional notation, including the decimal separator and the place values on either side of it.";
    rdfs:comment "For example: explaining why the 3 in 2.35 represents three tenths.";
    edu:expands :IntegerNotation;
    edu:specializes :NumberNotation.
:DecimalPadding a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Appending trailing zeros to a finite decimal representation to express the same value with additional decimal places.";
    rdfs:comment "For example: writing 2.5 as 2.50 before aligning decimal places in an addition.";
    edu:specializes :DecimalEquivalence.
:DecimalPointAlignment a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Aligning the decimal separators of numbers so corresponding place values line up during an operation.";
    rdfs:comment "For example: placing the decimal points of 3.2 and 0.45 in one column before adding.";
    edu:partOf :DecimalArithmetic.
:DecimalPrecission a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The number of decimal places used to represent a value and the place value of the last displayed digit.";
    rdfs:comment "For example: 3.14 is written to two decimal places. The number of displayed places does not by itself establish a measurement's accuracy.";
    edu:expands :DecimalEquivalence;
    edu:partOf :DecimalArithmetic.
:DecimalRounding a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Approximating a decimal value to a specified place by selecting the appropriate nearby value under a stated rounding convention.";
    rdfs:comment "For example: rounding 3.146 to 3.15 to the nearest hundredth.";
    edu:expands :DecimalPrecission, :IntegerRounding;
    edu:partOf :DecimalArithmetic.
:DecimalStrategies a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Recognizable methods for coordinating decimal place value and arithmetic relationships to obtain or explain a result.";
    edu:partOf :DecimalArithmetic.
:Decrement a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Reducing a quantity by a specific amount.";
    edu:expands :NumericOrder;
    edu:inverts :Increment;
    edu:partOf :FoundationalOperations.
:Difference a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining how two quantities or mathematical objects differ, including the amount separating two numerical values.";
    rdfs:comment "For example: finding how many more objects one collection contains than another.";
    edu:expands :Decrement, :PartitionOfCollections;
    edu:integrates :Iteration;
    edu:inverts :Sum;
    edu:partOf :FoundationalOperations.
:DigitNotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The use and interpretation of the digit symbols 0 through 9 in numerical representations.";
    rdfs:comment "For example: identifying the digit symbols in 307 and distinguishing them from the value of the whole numeral.";
    edu:expands :NumericIdentity;
    edu:specializes :NumberNotation.
:Dilation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A transformation that produces an image that is the same shape as the original, but is a different size, altering the scale of the geometric object.";
    edu:expands :ShapeResizingConservation;
    edu:specializes :GeometricTransformations.
:DistanceCalculation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The calculation of distance between two points.";
    edu:expands :Difference;
    edu:partOf :GeometricCalculations.
:DistributiveLaw a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The mathematical principle stating that multiplying a sum by a number gives the same result as multiplying each addend by the number and then adding the products together.";
    edu:expands :Addition, :Multiplication;
    edu:partOf :MathematicalLaws.
:DivisibilityRules a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Shorthand methods of determining whether a given integer is divisible by a fixed divisor without performing the division.";
    edu:partOf :Factorization.
:Division a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Finding the value that, when multiplied by a nonzero divisor, gives the dividend.";
    rdfs:comment "For example: 12 divided by 3 equals 4 because 3 × 4 = 12.";
    edu:expands :Subtraction;
    edu:integrates :Iteration;
    edu:inverts :Multiplication;
    edu:partOf :BaseOperations;
    edu:translates :DivisionOfCollections.
:DivisionDividendPartitioning a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Dividing by decomposing the dividend into convenient divisible parts and combining their quotients.";
    edu:expands :DistributiveLaw, :Division, :FactorsAndMultiples;
    edu:partOf :IntegerStrategies.
:DivisionKnownFactDerivation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Deriving a division result from a known multiplication or division fact through inverse-operation and number relationships.";
    edu:expands :Division, :FactorsAndMultiples, :Multiplication;
    edu:partOf :IntegerStrategies.
:DivisionOfCollections a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The physical, visual or symbolized act of splitting a single bounded collection into two or more distinct non-overlapping subcollections of equal cardinality. The source cardinality equals the number of subcollections multiplied by their shared cardinality, so either factor can be determined through division.";
    edu:expands :NumericEquality, :PartitionOfCollections;
    edu:partOf :CollectionSense.
:DivisionPartialQuotients a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Dividing by successively removing convenient multiples of the divisor and combining the associated partial quotients.";
    edu:expands :Division, :FactorsAndMultiples, :Multiplication, :Subtraction;
    edu:partOf :IntegerStrategies.
:DivisionStandardAlgorithm a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The conventional base-ten division algorithm that determines successive quotient places through repeated estimation, multiplication, subtraction, and redistribution of the remaining value.";
    edu:expands :DivisionPartialQuotients, :IntegerRegrouping;
    edu:partOf :IntegerStrategies.
:EmergentFeatureRecognition a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Recognizing a recurring, alternating, invariant, or otherwise systematic property of generated pattern elements that follows from, but is not itself, the generative rule.";
    edu:specializes :PatternRecognition.
:Equation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A mathematical statement asserting that two expressions have equal value.";
    edu:expands :NumericIdentity;
    edu:specializes :MathematicalStatement.
:EquilateralTriangle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A triangle in which all three sides are of equal length and all three angles are 60 degrees.";
    edu:expands :SymmetryRelation;
    edu:specializes :Triangle.
:Estimation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Intuitively guessing relative quantities and sizes without counting.";
    edu:expands :NumericComparison;
    edu:specializes :NumericApproximation.
:EvenDivisibility a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A division of collections in which the divisor is two, permitting the source collection to be partitioned into exactly two subcollections of equal cardinality. The result identifies the source cardinality as an even integer, consisting of a quotient that represents the shared cardinality of the subcollections and a remainder of zero.";
    edu:expands :SetComparison, :Subitizing;
    edu:specializes :DivisionOfCollections.
:Exponentiation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Raising a number to a specified power.";
    rdfs:comment "For example: 3 to the fourth power is 3 × 3 × 3 × 3 = 81. Repeated multiplication directly describes positive integer exponents; other exponents require the corresponding extended definitions.";
    edu:expands :Multiplication;
    edu:partOf :PowerOperations.
:Factorization a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The process of decomposing an integer into a product of other integers that, when multiplied together, result in the original number.";
    edu:partOf :NumberTheory.
:FactorsAndMultiples a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of integers that can be multiplied together to get another integer, and the products of an integer and another integer.";
    edu:expands :Division, :Multiplication;
    edu:partOf :Factorization.
:FormalMathematics a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The branch of mathematics dealing with the rigorous, symbolic representation of mathematical concepts, expressions, and propositions, serving as the standardized language to communicate and manipulate mathematical ideas.".
:FoundationalOperations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The foundational arithmetic concepts and operations on which more complex numerical procedures are built.";
    rdfs:comment "For example: combining quantities, finding differences, repeating an operation, or reversing an operation.";
    edu:partOf :NumberSense.
:FractionArithmetic a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding and operating on rational numbers expressed as a quotient of two integers with a nonzero denominator.";
    rdfs:comment "For example: adding fractions with a common denominator, simplifying a fraction, or comparing fraction magnitudes.";
    edu:expands :Division, :NumerationWithFractions, :ProportionInteraction;
    edu:partOf :RationalArithmetic.
:FractionCommonDenominatorComparison a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Comparing fraction magnitudes that share an equal denominator by comparing their counts of equal-sized parts.";
    edu:expands :FractionNumeratorInterpretation, :NumericComparison;
    edu:partOf :FractionStrategies.
:FractionCommonNumeratorComparison a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Comparing fraction magnitudes that share an equal numerator by reasoning inversely about the sizes of their unit-fraction parts.";
    edu:expands :FractionDenominatorInterpretation, :NumericComparison;
    edu:partOf :FractionStrategies.
:FractionDenominatorInterpretation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Interpreting a fraction's denominator as the number of equal-sized parts making one whole and relating it to the numerator and reference whole.";
    rdfs:comment "For example: explaining that the denominator 4 in 3/4 divides the reference whole into four equal parts.";
    edu:partOf :FractionInterpretation;
    edu:translates :RatioConsequentInterpretation.
:FractionEquivalence a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The principle that distinct representations of rational numbers in the form a/b can express the same ratio, where transformations between different numerators and denominators maintain the same value relative to the unit or whole.";
    edu:expands :RatioEquivalence;
    edu:partOf :FractionArithmetic.
:FractionInterpretation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Interpreting a fraction's value through its numerator, denominator, and reference whole or quantity.";
    rdfs:comment "For example: explaining how 3/4 describes three of four equal parts of the same whole.";
    edu:partOf :FractionArithmetic;
    edu:translates :RatioInterpretation.
:FractionNotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The symbols and conventions used to express a fraction through a numerator, a denominator, and their division relationship.";
    rdfs:comment "For example: explaining what the fraction bar and the two positions mean in 3/4.";
    edu:expands :IntegerNotation;
    edu:specializes :NumberNotation.
:FractionNumeratorInterpretation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Interpreting a fraction's numerator as the count of parts of the size determined by its denominator.";
    rdfs:comment "For example: explaining that the numerator 3 in 3/4 counts three quarter-sized parts.";
    edu:partOf :FractionInterpretation;
    edu:translates :RatioAntecedentInterpretation.
:FractionReferenceComparison a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Comparing fraction magnitudes against a shared reference value.";
    rdfs:comment "For example: comparing 3/8 and 5/8 by locating each relative to one half.";
    edu:expands :FractionInterpretation, :NumerationWithFractions, :NumericComparison;
    edu:partOf :FractionStrategies.
:FractionReferenceDistanceComparison a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Comparing fraction magnitudes located on the same side of a reference value by evaluating the size of their respective remaining distances to that value.";
    edu:expands :Difference, :FractionReferenceComparison;
    edu:partOf :FractionStrategies.
:FractionSimplification a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Reducing a fraction to an equivalent simplest form by dividing its numerator and denominator by their greatest common factor.";
    rdfs:comment "For example: 12/18 simplifies to 2/3 by dividing both numerator and denominator by 6.";
    edu:expands :FactorsAndMultiples;
    edu:partOf :FractionStrategies.
:FractionStrategies a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Recognizable methods for coordinating fraction magnitude, equivalence, and arithmetic relationships to obtain or explain a result.";
    edu:partOf :FractionArithmetic.
:GenerativeRuleRecognition a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Recognizing a generative rule that accounts for how the presented elements of a pattern are produced.";
    edu:specializes :PatternRecognition.
:GeometricCalculations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining measurable properties of geometric objects through mathematical calculation.";
    rdfs:comment "For example: calculating a perimeter, an area, or a volume.";
    edu:expands :MeasuringObjects;
    edu:integrates :Arithmetic;
    edu:partOf :Geometry.
:GeometricConcepts a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The fundamental objects, quantities, and structures used to describe geometric space.";
    rdfs:comment "For example: points, lines, planes, angles, and vectors.";
    edu:partOf :Geometry.
:GeometricObjects a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of specific geometric shapes and figures in one, two, and three dimensions.";
    edu:partOf :Geometry.
:GeometricRelations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of spatial and quantitative relationships between geometric entities.";
    rdfs:comment "For example: congruence, similarity, parallelism, and perpendicularity.";
    edu:partOf :Geometry.
:GeometricTransformations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Mappings that change a geometric figure's position, orientation, or scale according to a specified rule.";
    rdfs:comment "For example: a rotation, reflection, translation, or dilation.";
    edu:partOf :Geometry.
:GeometricVisualization a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of geometry using a coordinate system to define the position of points, lines, and shapes.";
    edu:partOf :Geometry.
:Geometry a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The branch of mathematics that studies shapes, the sizes, positions, and dimensions of things. It explores properties of points, lines, planes, and solids.".
:GroupRecognition a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The foundational cognitive ability to perceive multiple distinct items as a single, unified collection. This focuses on recognizing the boundary that separates a group from its environment, rather than analyzing the individual items within it.";
    edu:partOf :CollectionSense.
:HalfCircle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A two-dimensional geometric figure bounded by a semicircular arc and its diameter, representing one half of a circle.";
    rdfs:comment "For example: one of the two congruent regions formed by cutting a circular region along a diameter.";
    edu:partOf :CircularShapes.
:Hexagon a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A polygon with six edges and six vertices.";
    edu:specializes :Polygon.
:ImperfectDivisibility a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A division of collections in which the cardinality of the source collection is not an integer multiple of the divisor, preventing every source object from being assigned to the equal subcollections. The result consists of a quotient, representing the number or shared cardinality of the subcollections, and a remainder, representing the subset of source objects that cannot be distributed while maintaining equal cardinality.";
    edu:contradicts :PerfectDivisibility;
    edu:inverts :PerfectDivisibility;
    edu:specializes :DivisionOfCollections.
:Increment a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Raising a quantity by a certain amount.";
    edu:expands :NumericOrder;
    edu:partOf :FoundationalOperations.
:Inequality a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A mathematical statement asserting an order relation or non-equality between two expressions.";
    rdfs:comment "For example: x < 5, y ≥ 3, or a ≠ b.";
    edu:expands :NumericComparison;
    edu:specializes :MathematicalStatement.
:IntegerArithmetic a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding and operating on numbers with no fractional part, including positive integers, negative integers, and zero.";
    rdfs:comment "For example: adding signed integers or exchanging units between integer place values. Integer value is independent of whether a representation includes a decimal separator.";
    edu:expands :NumerationWithIntegers;
    edu:partOf :ArithmeticSpaces.
:IntegerNotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The symbols and conventions used to represent integer values.";
    rdfs:comment "For example: writing -3, 0, and 12, or interpreting a sign as part of an integer representation.";
    edu:expands :DigitNotation;
    edu:specializes :NumberNotation.
:IntegerRegrouping a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Exchanging an integer quantity between place-value units while preserving its value.";
    rdfs:comment "For example: exchanging one ten for ten ones during subtraction, or ten ones for one ten during addition. These operations are commonly called borrowing and carrying.";
    edu:expands :PlaceValue;
    edu:partOf :IntegerArithmetic.
:IntegerRounding a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Approximating an integer to a specified place value under a stated rounding convention.";
    rdfs:comment "For example: rounding 347 to 350 to the nearest ten, or to 300 to the nearest hundred.";
    edu:expands :PlaceValue;
    edu:partOf :IntegerArithmetic.
:IntegerStrategies a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Recognizable methods for coordinating integer number relationships, place value, and arithmetic operations to obtain or explain a result.";
    edu:partOf :IntegerArithmetic.
:IntersectionOfCollections a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Identifying the objects that belong to each of two overlapping collections.";
    rdfs:comment "For example: identifying the objects in the overlap of two physical hoops or two represented groups.";
    edu:expands :ObjectSorting;
    edu:partOf :CollectionSense.
:IntersectionRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The relationship between geometric entities that share one or more common points where they meet or cross.";
    edu:expands :LineConcept, :PlaneConcept;
    edu:partOf :PositionalRelations.
:IntervalsWithInfinity a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Intervals of numbers with no finite bound in at least one direction.";
    rdfs:comment "For example: the interval of all real numbers greater than 3. Infinity indicates an unbounded direction rather than an included endpoint.";
    edu:specializes :NumerationWithIntervals.
:IntuitiveMathematics a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The branch of mathematics that focuses on understanding foundational math concepts through direct experience and visualization, gradually familiarizing students with increasingly formal and abstract representations of math concepts.".
:IsoscelesTriangle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A triangle that has at least two sides of equal length.";
    edu:expands :SymmetryRelation;
    edu:specializes :Triangle.
:IteratedOperation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "An arithmetic evaluation that repeatedly applies the same arithmetic operations on a single operand value.";
    edu:expands :ArithmeticOperations;
    edu:specializes :ArithmeticEvaluation.
:Iteration a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Repeatedly applying the exact same operation, evaluation or rule an exact number of times.";
    edu:expands :Numeration;
    edu:partOf :FoundationalOperations.
:Kite a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A quadrilateral with two distinct pairs of equal-length sides that are adjacent to each other.";
    edu:expands :SymmetryRelation;
    edu:specializes :Quadrilateral.
:LengthCalculation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The calculation of the linear extent or measurement of a geometric object.";
    edu:expands :DistanceCalculation;
    edu:integrates :TrigonometricRelations;
    edu:partOf :GeometricCalculations.
:LinearDrawing a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Creating drawings or models of straight lines.";
    rdfs:comment "For example: drawing a straight line through two given points.";
    edu:partOf :SpatialModelling.
:LinearShapeDrawing a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Creating drawings or models of figures bounded by straight line segments.";
    rdfs:comment "For example: drawing a triangle from specified vertices.";
    edu:partOf :SpatialModelling.
:LineConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A straight, one-dimensional figure that has no thickness and extends infinitely in both directions.";
    edu:expands :PointConcept;
    edu:partOf :GeometricConcepts.
:LineGraphing a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Representing a straight line in a coordinate plane from its defining points or algebraic relationship.";
    rdfs:comment "For example: plotting two points satisfying y = 2x + 1 and drawing the line through them.";
    edu:expands :PointPlotting;
    edu:partOf :GeometricVisualization.
:LineSegment a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A part of a line that is bounded by two distinct end points, and contains every point on the line that is between its endpoints.";
    edu:expands :LinearDrawing;
    edu:partOf :OneDimensionalObjects.
:Logarithm a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Finding the exponent to which a base must be raised to produce a given number.";
    edu:inverts :Exponentiation;
    edu:partOf :PowerOperations.
:Logic a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of valid reasoning and the conditions under which conclusions follow from premises.";
    rdfs:comment "For example: evaluating an implication or checking the structure of a proof.".
:LowestCommonDenominator a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Finding the least common multiple of the positive denominators of two or more fractions.";
    rdfs:comment "For example: the lowest common denominator of 1/4 and 1/6 is 12.";
    edu:expands :FactorsAndMultiples;
    edu:partOf :FractionStrategies.
:LowestCommonNumerator a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Finding the least common multiple of the positive numerators of two or more fractions to express them with a shared numerator.";
    rdfs:comment "For example: 2/5 and 3/7 can be written as 6/15 and 6/14 using the lowest common numerator 6.";
    edu:expands :FactorsAndMultiples;
    edu:partOf :FractionStrategies.
:MathematicalExpression a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A well-formed, finite combination of symbols and operations that represents a value but does not contain a relational operator.";
    edu:partOf :FormalMathematics.
:MathematicalLaws a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The fundamental axiomatic rules that govern the manipulation and equivalence of mathematical expressions and statements.";
    edu:partOf :FormalMathematics.
:MathematicalStatement a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A declarative mathematical sentence that asserts a relation between expressions and can be evaluated as true or false.";
    edu:partOf :FormalMathematics.
:Measurement a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Comparing or quantifying a measurable attribute, either qualitatively or by assigning a value relative to a unit.";
    rdfs:comment "For example: comparing two lengths directly, reading a weight, or measuring a duration.";
    edu:partOf :SpatialSense.
:MeasuringLength a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining or comparing the linear extent or one-dimensional distance of manifested objects directly, through an intermediary, or by using tools and units.";
    edu:specializes :MeasuringObjects.
:MeasuringObjects a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining or comparing measurable physical dimensions of manifested objects directly, through an intermediary, or by using tools and units.";
    edu:partOf :Measurement.
:MeasuringTime a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining or comparing the durations of events or the intervals between them.";
    rdfs:comment "For example: finding how long an activity lasts from its start and finish times.";
    edu:partOf :Measurement.
:MeasuringVolumes a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining or comparing the three-dimensional extent or amount of space occupied by manifested objects directly, through an intermediary, or by using tools and units.";
    edu:specializes :MeasuringObjects.
:MeasuringWeight a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining or comparing the mass or heaviness of manifested objects directly, through an intermediary, or by using tools and units.";
    edu:specializes :MeasuringObjects.
:MeasuringWithUnits a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of standard units used to quantify physical properties, including their relative sizes, systems, and conversions.";
    edu:partOf :Measurement.
:MidpointCalculation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The process of finding the exact center point of a line segment on the coordinate plane by averaging the coordinates of its endpoints.";
    edu:partOf :GeometricCalculations.
:Modulo a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Finding the remainder after dividing one number by another.";
    edu:expands :Division;
    edu:partOf :BaseOperations;
    edu:translates :ImperfectDivisibility.
:Multiplication a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Combining numerical factors to determine their product, corresponding to equal groups for nonnegative whole-number factors.";
    rdfs:comment "For example: three groups of four have a total of twelve, expressed as 3 × 4 = 12. Fractional factors also describe proportional scaling.";
    edu:expands :Addition;
    edu:integrates :Iteration;
    edu:partOf :BaseOperations;
    edu:translates :PerfectDivisibility.
:MultiplicationDoublingAndHalving a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Preserving a product by repeatedly doubling one factor while halving the other.";
    edu:expands :Division, :FactorsAndMultiples, :Multiplication;
    edu:partOf :IntegerStrategies.
:MultiplicationKnownFactDerivation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Deriving an unknown multiplication result from one or more known multiplication facts through operation properties or number relationships.";
    edu:expands :FactorsAndMultiples, :Multiplication;
    edu:partOf :IntegerStrategies.
:MultiplicationPartialProducts a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Multiplying by decomposing one or both factors and combining the products of the resulting parts.";
    edu:expands :DistributiveLaw, :Multiplication, :PlaceValue;
    edu:partOf :IntegerStrategies.
:MultiplicationStandardAlgorithm a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The conventional base-ten multiplication algorithm that obtains and combines place-aligned partial products in its standard written form.";
    edu:expands :IntegerRegrouping, :MultiplicationPartialProducts;
    edu:partOf :IntegerStrategies.
:NumberNameNotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The words and conventions used to express numerical values in written language.";
    rdfs:comment "For example: writing 437 as four hundred thirty-seven.";
    edu:expands :NumericIdentity;
    edu:specializes :NumberNotation.
:NumberNotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The systems of symbols and conventions used to express numerical values.";
    rdfs:comment "For example: positional numerals, fraction notation, decimal notation, or number names.";
    edu:partOf :FormalMathematics.
:NumberSense a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Intuitive understanding of numbers, their magnitudes, and their relationships.";
    rdfs:comment "For example: locating a value relative to zero or estimating which of two quantities is larger.";
    edu:partOf :IntuitiveMathematics.
:NumberTheory a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of integers and their arithmetic properties and relationships.";
    rdfs:comment "For example: investigating prime numbers, divisibility, or integer factorization.".
:Numeration a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Counting, ordering, and grouping numbers and relating them to numerical representations.";
    rdfs:comment "For example: continuing a counting sequence or organizing quantities by place value.";
    edu:partOf :NumberSense.
:NumerationWithDecimals a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding decimal place values and the order and magnitude of decimal values on the number line.";
    rdfs:comment "For example: placing 0.3 and 0.35 on a number line or identifying the value of a hundredths digit.";
    edu:expands :NumerationWithFractions;
    edu:specializes :Numeration.
:NumerationWithFractions a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding fraction magnitudes, their order, and the availability of further fraction values between distinct values on the number line.";
    rdfs:comment "For example: locating 1/2 and 3/4 and identifying a fraction between them.";
    edu:expands :NumerationWithIntegers;
    edu:specializes :Numeration.
:NumerationWithIntegers a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding the sequence, order, and magnitude of integer values.";
    rdfs:comment "For example: ordering -2, 0, and 3 on a number line.";
    edu:specializes :Numeration.
:NumerationWithIntervals a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Representing sets of numbers by their lower and upper bounds and the inclusion or exclusion of their endpoints.";
    rdfs:comment "For example: describing all values from 2 through 5 inclusive, or values greater than 2 and less than 5.";
    edu:specializes :Numeration.
:NumericApproximation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Estimating or replacing a numerical value with a nearby value suited to a stated purpose or precision.";
    rdfs:comment "For example: using a rounded measurement when estimating a total.";
    edu:partOf :NumberSense.
:NumericComparison a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining whether one numerical value is greater than, less than, or equal to another.";
    rdfs:comment "For example: comparing quantities represented by 3/4 and 0.8.";
    edu:partOf :NumberSense.
:NumericEquality a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining that two numerical quantities or expressions have the same value.";
    rdfs:comment "For example: establishing that 1/2 and 0.5 represent equal quantities.";
    edu:expands :NumericOrder;
    edu:partOf :NumericComparison.
:NumericIdentity a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding that a number retains its value across different representations.";
    rdfs:comment "For example: recognizing the same quantity in a numeral, a number name, and a collection of objects.";
    edu:partOf :NumericComparison.
:NumericInequality a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining that two numerical quantities or expressions have different values.";
    rdfs:comment "For example: establishing that 3 + 4 and 2 + 6 are unequal.";
    edu:contradicts :NumericEquality;
    edu:partOf :NumericComparison.
:NumericOrder a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Arranging numerical values in a sequence according to their magnitude.";
    rdfs:comment "For example: ordering 0.2, 1/2, and 1 from least to greatest.";
    edu:expands :NumericIdentity;
    edu:partOf :NumericComparison.
:ObjectSorting a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Separating a mixed collection into distinct groups according to shared observable attributes.";
    rdfs:comment "For example: sorting objects by color, shape, or size. Sorting forms groups; identifying a subgroup need not rearrange the collection.";
    edu:expands :GroupRecognition;
    edu:partOf :CollectionSense.
:ObtuseAngle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "An angle that measures more than 90 degrees but less than 180 degrees.";
    edu:specializes :AngleConcept.
:ObtuseTriangle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A triangle that has one obtuse angle.";
    edu:integrates :ObtuseAngle;
    edu:specializes :Triangle.
:OddAndEvenNumbers a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Determining whether an integer is divisible by two from its numerical representation.";
    rdfs:comment "For example: using the last digit of 348 to identify it as even.";
    edu:expands :EvenDivisibility, :PlaceValue;
    edu:partOf :DivisibilityRules.
:OneDimensionalObjects a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Geometric objects with length but no width or depth.";
    rdfs:comment "For example: lines, line segments, and rays.";
    edu:expands :LineConcept;
    edu:partOf :GeometricObjects.
:OrderOfOperations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The standard set of rules that dictates the sequence in which multiple operations in an arithmetic expression must be performed to ensure a single, correct result.";
    edu:partOf :MathematicalLaws.
:Origin a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The point (0,0) where the coordinate axes intersect on the Cartesian plane.";
    edu:expands :CoordinateAxes;
    edu:partOf :CartesianPlane;
    edu:translates :ZeroConcept.
:ParallelismRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The relationship between lines or planes that are always the same distance apart and never intersect.";
    edu:inverts :IntersectionRelation;
    edu:partOf :PositionalRelations.
:Parallelogram a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of four-sided polygons with two pairs of parallel sides, their properties, and related measurements.";
    edu:expands :ParallelismRelation;
    edu:specializes :Quadrilateral.
:ParenthesesUsage a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The use of grouping symbols in arithmetic expressions to override the standard order of operations and specify which calculations should be performed first.";
    edu:expands :OrderOfOperations;
    edu:partOf :MathematicalExpression.
:PartitionOfCollections a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The physical, visual or symbolized act of splitting a single bounded collection into two or more distinct non-overlapping subcollections, establishing boundaries between them.";
    edu:expands :GroupRecognition;
    edu:inverts :UnionOfCollections;
    edu:partOf :CollectionSense.
:PartitiveDivision a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A division of collections in which the cardinality of the source collection and the required number of equal subcollections are given. Every source object is assigned to exactly one subcollection, and the quotient is the shared cardinality of each resulting subcollection.";
    edu:specializes :DivisionOfCollections.
:PatternCorrespondence a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Identifying a systematic relationship between aligned elements of two patterns.";
    edu:expands :PatternRecognition;
    edu:partOf :PatternMatching.
:PatternGeneration a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Constructing successive elements of a pattern by repeatedly applying a given rule from a specified starting condition.";
    edu:expands :Iteration;
    edu:partOf :PatternMatching.
:PatternMatching a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of systematic correspondences among pattern elements, generative rules, emergent features, and related patterns.";
    edu:partOf :IntuitiveMathematics.
:PatternRecognition a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Recognizing that a sequence or configuration exhibits a systematic regularity.";
    edu:partOf :PatternMatching.
:Pentagon a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A polygon with five edges and five vertices.";
    edu:specializes :Polygon.
:PercentageArithmetic a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The understanding and application of numbers expressed as a fraction of 100.";
    edu:partOf :RationalArithmetic.
:PercentageEquivalence a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The rules and procedures for establishing the equality between percentages, fractions, and decimals.";
    edu:expands :DecimalEquivalence;
    edu:partOf :PercentageArithmetic.
:PercentageNotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The system of symbols used to represent percentages, specifically the percent sign (%).";
    edu:expands :DecimalNotation;
    edu:specializes :NumberNotation.
:PerfectDivisibility a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A division of collections in which the cardinality of the source collection is an integer multiple of the divisor, permitting every source object to be assigned to the equal subcollections. The result consists of a quotient, representing the number or shared cardinality of the subcollections, and a remainder of zero, indicating that the source collection is partitioned entirely into subcollections of equal cardinality.";
    edu:specializes :DivisionOfCollections.
:PerimeterCalculation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Calculating the total length of a closed plane figure's boundary.";
    rdfs:comment "For example: adding the side lengths of a polygon.";
    edu:expands :LengthCalculation;
    edu:partOf :GeometricCalculations.
:PerpendicularityRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The relationship between two geometric objects that intersect at a right angle (90 degrees).";
    edu:expands :IntersectionRelation;
    edu:partOf :PositionalRelations.
:Pi a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The mathematical constant representing the ratio of a circle's circumference to its diameter.";
    edu:partOf :CircleRelations.
:PlaceValue a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The numerical value that a digit has by virtue of its position in a number.";
    edu:expands :ZeroConcept;
    edu:partOf :IntegerArithmetic.
:PlaneConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A flat, two-dimensional surface that extends infinitely far.";
    edu:expands :LineConcept;
    edu:partOf :GeometricConcepts.
:PointConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A precise location or position on a plane, usually represented by a dot.";
    edu:expands :SpatialModelling;
    edu:partOf :GeometricConcepts.
:PointPlotting a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The process of locating and marking a point on a coordinate plane using a pair of numerical coordinates.";
    edu:expands :NumericOrder, :PointConcept;
    edu:partOf :GeometricVisualization.
:Polygon a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of closed, multi-sided geometric figures formed by straight line segments, their properties, and related measurements.";
    edu:expands :LineSegment, :LinearShapeDrawing;
    edu:partOf :TwoDimensionalObjects.
:Polyhedron a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A solid geometric figure that has flat polygonal faces, straight edges, and vertices.";
    edu:expands :Polygon;
    edu:partOf :ThreeDimensionalObjects.
:PositionalRelations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of relationships describing how geometric lines, planes, or segments interact, intersect, or positionally relate to one another in space.";
    edu:partOf :GeometricRelations.
:PowerOperations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The specialized application of mathematical rules and procedures to perform higher-order calculations through the actions of exponentiation, root extraction, and logarithmic derivation.";
    edu:partOf :ArithmeticOperations.
:PrimeNumbers a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of whole numbers greater than 1 that cannot be exactly divided by any whole number other than itself and 1.";
    edu:expands :FactorsAndMultiples;
    edu:partOf :Factorization.
:Prism a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A solid geometric figure that has two congruent and parallel bases and lateral faces that are parallelograms.";
    edu:expands :Parallelogram;
    edu:specializes :Polyhedron.
:ProportionAbstraction a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Generalizing a proportional relationship beyond a particular representation or situation.";
    rdfs:comment "For example: recognizing the same scaling relationship in a recipe and a geometric enlargement.";
    edu:partOf :ProportionSense.
:ProportionalScaling a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Applying a ratio or scale factor to a reference quantity to determine a corresponding quantity.";
    rdfs:comment "For example: tripling a recipe's quantities while preserving their proportions.";
    edu:partOf :ProportionInteraction.
:ProportionExpression a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Representing proportional relationships with mathematical symbols or equations.";
    rdfs:comment "For example: expressing a constant ratio as y = 3x.";
    edu:partOf :ProportionInteraction.
:ProportionIdentification a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Recognizing when quantities are related by a constant ratio or scale factor.";
    rdfs:comment "For example: determining whether a table pairs quantities in a fixed ratio.";
    edu:partOf :ProportionInteraction.
:ProportionInteraction a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Analyzing and using proportional relationships to solve a problem.";
    rdfs:comment "For example: finding an unknown quantity from a known ratio and a reference quantity.";
    edu:partOf :ProportionSense.
:ProportionManipulation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Changing quantities in a proportional relationship while preserving the ratio that relates them.";
    rdfs:comment "For example: doubling both quantities in a ratio to form an equivalent pair.";
    edu:partOf :ProportionInteraction.
:ProportionSense a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding and reasoning about relative quantities through ratios and proportional relationships.";
    rdfs:comment "For example: recognizing that doubling every ingredient preserves a mixture's proportions.";
    edu:partOf :IntuitiveMathematics.
:Pyramid a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A polyhedron formed by connecting a polygonal base and a point, called the apex.";
    edu:expands :Rectangle, :Triangle;
    edu:specializes :Polyhedron.
:Quadrants a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The four regions formed by the perpendicular coordinate axes in a Cartesian plane.";
    rdfs:comment "For example: a point with positive x and negative y lies in quadrant IV. The conventional numbering starts at the upper right and proceeds counterclockwise.";
    edu:partOf :CartesianPlane.
:Quadrilateral a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A polygon with four edges and four vertices.";
    edu:specializes :Polygon.
:QuarterCircle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A two-dimensional geometric figure bounded by a quarter-circle arc and two perpendicular radii, representing one fourth of a circle.";
    rdfs:comment "For example: one of four congruent regions formed by two perpendicular diameters.";
    edu:partOf :CircularShapes.
:QuotativeDivision a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A division of collections in which the cardinality of the source collection and the required cardinality of each equal subcollection are given. Every source object is assigned to exactly one subcollection, and the quotient is the number of resulting subcollections.";
    edu:specializes :DivisionOfCollections.
:RadiusDiameterRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The proportional relationship stating that the diameter of a circle is exactly twice the length of its radius.";
    edu:partOf :CircleRelations.
:RatioAntecedentInterpretation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Interpreting the first quantity in an ordered ratio and its relationship to the second quantity.";
    rdfs:comment "For example: explaining what the 2 represents in a ratio of two red objects to three blue objects.";
    edu:partOf :RatioInterpretation.
:RatioConsequentInterpretation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Interpreting the second quantity in an ordered ratio and its relationship to the first quantity.";
    rdfs:comment "For example: explaining what the 3 represents in a ratio of two red objects to three blue objects.";
    edu:partOf :RatioInterpretation.
:RatioEquivalence a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding that different ordered pairs of quantities can express the same ratio.";
    rdfs:comment "For example: relating 2:3 to 4:6 by scaling both quantities by the same factor.";
    edu:expands :ProportionManipulation;
    edu:partOf :ProportionAbstraction.
:RatioInterpretation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Interpreting the quantities and multiplicative relationship expressed by an ordered ratio.";
    rdfs:comment "For example: explaining the reference quantities represented by 2:3 in a mixture.";
    edu:partOf :ProportionAbstraction.
:RationalArithmetic a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The understanding and application of numbers that can be expressed as the quotient or fraction of two integers, where the denominator is non-zero.";
    edu:partOf :ArithmeticSpaces.
:RatioNotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Applying the system of symbols and conventions used to represent ratios.";
    edu:specializes :NumberNotation.
:RayConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A straight, one-dimensional figure that starts at a fixed point and extends infinitely in one direction.";
    edu:expands :LineConcept;
    edu:partOf :GeometricConcepts.
:Rectangle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of four-sided polygons with four right angles, their properties, and related measurements.";
    edu:integrates :RightAngle;
    edu:specializes :Parallelogram.
:RectangularPrism a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A solid geometric figure that has six rectangular faces where each pair of opposite faces is congruent and parallel.";
    edu:expands :Rectangle;
    edu:specializes :Prism.
:Reflection a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A transformation that flips a geometric figure across a line, creating a mirror image.";
    edu:expands :ShapeReflection;
    edu:specializes :GeometricTransformations.
:ReflexAngle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "An angle that measures more than 180 degrees but less than 360 degrees.";
    edu:specializes :AngleConcept.
:Rhombus a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A parallelogram with four equal-length sides.";
    edu:specializes :Parallelogram.
:RightAngle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "An angle of exactly 90 degrees, corresponding to a quarter turn.";
    edu:expands :PerpendicularityRelation;
    edu:specializes :AngleConcept.
:RightTriangle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A triangle that has one right angle.";
    edu:integrates :RightAngle;
    edu:specializes :Triangle.
:Root a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Finding a value whose specified power equals a given number, within the stated number system and root convention.";
    rdfs:comment "For example: the cube root of 64 is 4 because 4 × 4 × 4 = 64.";
    edu:inverts :Exponentiation;
    edu:partOf :PowerOperations.
:Rotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A transformation that turns a geometric figure around a fixed point, known as the center of rotation, by a specific angle.";
    edu:expands :ShapeRotationConservation;
    edu:specializes :GeometricTransformations.
:Rounding a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The mathematical procedure of adjusting a number to a simpler or shorter value that is close to its original value.";
    edu:specializes :NumericApproximation.
:RulesOfSigns a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The fundamental rules that govern the manipulation and evaluation of signed numbers within arithmetic expressions, ensuring the consistent and accurate determination of positive and negative results.";
    edu:expands :SignNotation;
    edu:partOf :MathematicalLaws.
:ScaleneTriangle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A triangle in which all three sides have different lengths.";
    edu:inverts :EquilateralTriangle;
    edu:specializes :Triangle.
:SetComparison a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Comparing the quantities of two bounded collections intuitively or visually without formal counting.";
    rdfs:comment "For example: judging which of two visibly matched groups has extra objects.";
    edu:expands :GroupRecognition, :NumericOrder;
    edu:partOf :CollectionSense.
:SetTheory a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The branch of mathematics that studies sets, which are collections of objects. It provides a fundamental language and tools for defining and working with mathematical objects.".
:ShapeClassification a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Classifying geometric shapes by their defining attributes.";
    rdfs:comment "For example: classifying a figure by its number of sides and the relationships among its angles.";
    edu:expands :ShapeNaming;
    edu:partOf :ShapeIdentity.
:ShapeConservation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding which properties of a shape remain unchanged when its position, orientation, or scale changes.";
    edu:expands :ShapeRecognition;
    edu:partOf :ShapeIdentity.
:ShapeDecomposition a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding how a whole shape can be resolved into component shapes.";
    edu:inverts :ShapeSynthesis;
    edu:partOf :ShapePartWholeRelations.
:ShapeEquivalenceRelations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of relationships that compare the intrinsic shape, size, and mapping of geometric figures to one another.";
    edu:partOf :GeometricRelations.
:ShapeIdentity a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding a geometric shape as a recognizable kind through its form, defining attributes, category relationships, and structural descriptions.";
    edu:partOf :SpatialSense.
:ShapeNaming a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding how to associate a represented geometric shape with its conventional name.";
    edu:expands :ShapeRecognition;
    edu:partOf :ShapeIdentity.
:ShapePartWholeRelations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding how shapes can be composed from or decomposed into other shapes, and how these part-whole structures reveal relationships between geometric forms.";
    edu:expands :ShapeRecognition;
    edu:partOf :ShapeIdentity.
:ShapePlotting a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Drawing a geometric figure in a coordinate system from its defining coordinates or relationships.";
    rdfs:comment "For example: plotting a polygon's vertices and joining adjacent vertices.";
    edu:expands :PointPlotting;
    edu:partOf :GeometricVisualization;
    edu:translates :Polygon.
:ShapeRecognition a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding how to visually identify and group multiple geometric shapes as belonging to the same category or concept based on their shared form and structural characteristics.";
    edu:partOf :ShapeIdentity.
:ShapeReflection a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding reflective symmetry as a defining property of a shape's form, where a line of symmetry divides the shape into identical, mirroring halves.";
    edu:expands :ShapeDecomposition;
    edu:partOf :ShapePartWholeRelations.
:ShapeResizingConservation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding how a shape can be increased or decreased in size while maintaining its original form.";
    edu:specializes :ShapeConservation.
:ShapeRotationConservation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding how a shape can be turned around a fixed point while maintaining its original size and form.";
    edu:specializes :ShapeConservation.
:ShapeSubsumption a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding containment among shape categories, where every member of a narrower category also belongs to a broader category.";
    rdfs:comment "For example: every square is a rectangle, and every rectangle is a quadrilateral.";
    edu:expands :ShapeClassification;
    edu:partOf :ShapeIdentity.
:ShapeSynthesis a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding how multiple component shapes can be combined to form a new whole shape.";
    edu:partOf :ShapePartWholeRelations.
:ShapeTranslationConservation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding how a shape can be slid in a specific direction while maintaining its original size, orientation, and form.";
    edu:specializes :ShapeConservation.
:SignNotation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The identification and application of positive (+) and negative (-) symbols to indicate a number's direction and magnitude relative to zero.";
    edu:expands :AbsoluteNumberMagnitude, :ZeroConcept;
    edu:specializes :NumberNotation.
:SimilarityRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The relationship between geometric figures that have the same shape, with corresponding angles being equal and corresponding sides being in proportion.";
    edu:expands :ShapeResizingConservation;
    edu:partOf :ShapeEquivalenceRelations;
    edu:translates :ShapeRotationConservation.
:Sine a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The trigonometric function that is equal to the ratio of the side opposite a given angle (in a right-angled triangle) to the hypotenuse.";
    edu:partOf :TrigonometricRelations.
:SlopeConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The measure of the steepness and direction of a line, calculated as the ratio of the vertical change (rise) to the horizontal change (run) between two points.";
    edu:expands :RatioInterpretation;
    edu:partOf :GeometricVisualization.
:SpaceConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A boundless, three-dimensional extent that contains all geometric figures and extends infinitely in all directions.";
    edu:expands :PlaneConcept;
    edu:partOf :GeometricConcepts.
:SpatialModelling a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Creating mental or physical representations of objects and their spatial relationships.";
    edu:partOf :SpatialSense.
:SpatialPosition a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding the location, orientation, and direction of objects in space relative to other objects or a frame of reference.";
    edu:partOf :SpatialSense.
:SpatialSense a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding shapes, sizes, positions, and movements in two and three dimensions.";
    edu:partOf :IntuitiveMathematics.
:Sphere a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A solid geometric figure that is perfectly round and defined by a surface where every point is equidistant from a central point.";
    edu:expands :Circle;
    edu:partOf :ThreeDimensionalObjects.
:Square a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of four-sided polygons with four right angles and four equal sides, their properties, and related measurements.";
    edu:specializes :Rectangle.
:Statistics a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The branch of mathematics that provides a framework for collecting, organizing, analyzing, and interpreting data. It provides tools for quantifying and modeling randomness, variability, and uncertainty in data.".
:StraightAngle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "An angle that measures exactly 180 degrees, forming a straight line.";
    edu:specializes :AngleConcept.
:Subitizing a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The ability to instantly recognize the number of objects in a small group without counting.";
    edu:expands :GroupRecognition;
    edu:partOf :NumberSense.
:SubsetIdentification a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Identifying a part of a pre-existing collection by a distinguishing attribute while retaining its relationship to the whole.";
    rdfs:comment "For example: identifying the red cars within a box of toys without rearranging the collection.";
    edu:expands :ObjectSorting;
    edu:partOf :CollectionSense.
:Subtraction a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Finding the difference between two numbers.";
    edu:expands :Difference;
    edu:inverts :Addition;
    edu:partOf :BaseOperations;
    edu:translates :PartitionOfCollections.
:SubtractionCompensation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Subtracting after applying a value-preserving adjustment that makes the minuend or subtrahend more convenient.";
    edu:expands :Subtraction;
    edu:partOf :IntegerStrategies.
:SubtractionCountingBack a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Subtracting by starting from the minuend and counting backward by the subtrahend.";
    edu:expands :Decrement, :Subtraction;
    edu:partOf :IntegerStrategies.
:SubtractionMakeTen a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Subtracting by decomposing the subtrahend so that an initial subtraction reaches ten or a larger power-of-ten landmark, then subtracting the remaining part.";
    edu:expands :PlaceValue, :Subtraction;
    edu:partOf :IntegerStrategies.
:SubtractionPlaceValuePartitioning a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Subtracting by decomposing one or both operands into place-value parts and coordinating the partial differences.";
    edu:expands :PlaceValue, :Subtraction;
    edu:partOf :IntegerStrategies.
:SubtractionStandardAlgorithm a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The conventional base-ten subtraction algorithm that operates by aligned place values and records any required regrouping across places.";
    edu:expands :IntegerRegrouping, :SubtractionPlaceValuePartitioning;
    edu:partOf :IntegerStrategies.
:SubtractionThinkAddition a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Solving a subtraction by determining the missing addend that combines with the subtrahend to produce the minuend.";
    edu:expands :Addition, :Subtraction;
    edu:partOf :IntegerStrategies.
:Sum a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Combining mathematical quantities to determine their total.";
    rdfs:comment "For example: combining numerical values or adding vectors.";
    edu:expands :Increment, :UnionOfCollections;
    edu:integrates :Iteration;
    edu:partOf :FoundationalOperations.
:SupplementaryAngles a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Two angles whose sum is exactly 180 degrees.";
    edu:partOf :AngleRelations.
:SurfaceAreaCalculation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The calculation of the total area of the surface of a three-dimensional object.";
    edu:expands :AreaCalculation, :SpaceConcept;
    edu:partOf :GeometricCalculations.
:SymmetryRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The invariance of a geometric figure under a transformation that maps it onto itself.";
    rdfs:comment "For example: a reflection across a square's diagonal or a half-turn about its center.";
    edu:expands :ShapeReflection;
    edu:partOf :ShapeEquivalenceRelations;
    edu:translates :ShapeResizingConservation, :ShapeRotationConservation.
:Tangent a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The trigonometric function that is equal to the ratio of the side opposite a given angle to the side adjacent to that angle.";
    edu:partOf :TrigonometricRelations.
:TangentRadiusRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The geometric rule stating that a tangent line to a circle is perpendicular to the radius at the exact point of tangency.";
    edu:partOf :CircleRelations.
:ThreeDimensionalObjects a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Solid geometric figures with length, width, and depth.";
    rdfs:comment "For example: spheres, cubes, and cylinders.";
    edu:expands :SpaceConcept;
    edu:partOf :GeometricObjects.
:Translation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A transformation that slides a geometric figure in a specific direction and by a specific distance without altering its shape, size, or orientation.";
    edu:expands :ShapeTranslationConservation;
    edu:specializes :GeometricTransformations.
:Trapezoid a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A quadrilateral with at least one pair of parallel sides.";
    edu:expands :ParallelismRelation;
    edu:specializes :Quadrilateral.
:Triangle a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of three-sided polygons, their properties, and related measurements.";
    edu:specializes :Polygon.
:TrigonometricRelations a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The study of the relationships between the angles and side lengths of triangles, primarily focusing on right-angled triangles.";
    edu:expands :AngleConcept;
    edu:partOf :GeometricRelations.
:TwoDimensionalObjects a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Plane geometric figures with length and width but no depth.";
    rdfs:comment "For example: polygons, circles, and semicircular regions.";
    edu:expands :PlaneConcept;
    edu:partOf :GeometricObjects.
:UnevenDivisibility a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A division of collections in which the divisor is two, precluding the source collection from being partitioned into exactly two subcollections of equal cardinality. The result identifies the source cardinality as an odd integer, consisting of a quotient that represents the shared cardinality of the subcollections and a remainder of one.";
    edu:contradicts :EvenDivisibility;
    edu:specializes :DivisionOfCollections.
:UnionOfCollections a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The physical, visual or symbolized act of combining two or more distinct, bounded collections into a single larger collection, removing the boundaries between them.";
    edu:expands :GroupRecognition;
    edu:partOf :CollectionSense.
:UnitConversion a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Expressing the same measured quantity in a different unit by applying the relationship between the units.";
    rdfs:comment "For example: converting meters to centimeters or hours to minutes. Conversion factors may be exact; approximation is not an intrinsic requirement.";
    edu:expands :ProportionInteraction, :UnitFactorScaling, :UnitMagnitudeScaling;
    edu:partOf :MeasuringWithUnits.
:UnitFactorScaling a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The process of converting measurements within a system using specific, non-base-10 numerical conversion factors.";
    edu:expands :FactorsAndMultiples, :UnitScaleRelation;
    edu:partOf :MeasuringWithUnits.
:UnitMagnitudeScaling a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Converting a measurement between metric units related by powers of ten while preserving the measured quantity.";
    rdfs:comment "For example: expressing 1.5 meters as 150 centimeters by multiplying the numerical value by 100.";
    edu:expands :PlaceValue, :UnitScaleRelation;
    edu:partOf :MeasuringWithUnits.
:UnitScaleRelation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The foundational understanding of the inverse relationship between the size of a measurement unit and the numerical value obtained, specifically that measuring the same quantity with a larger unit results in a smaller number.";
    edu:expands :MeasuringObjects, :NumericComparison;
    edu:partOf :MeasuringWithUnits.
:VectorConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "A quantity with both magnitude and direction.";
    rdfs:comment "For example: a displacement represented by a directed line segment.";
    edu:expands :LineConcept;
    edu:partOf :GeometricConcepts.
:VerticalAngles a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The pairs of opposite angles made by two intersecting lines.";
    edu:partOf :AngleRelations.
:VolumeCalculation a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "The calculation of the amount of space that a substance or object occupies.";
    edu:expands :AreaCalculation, :SpaceConcept;
    edu:partOf :GeometricCalculations.
:ZeroConcept a owl:NamedIndividual, edu:Area;
    rdfs:isDefinedBy "Understanding zero as an integer expressing absence of quantity, the additive identity, and the origin between negative and positive values.";
    rdfs:comment "For example: recognizing that adding zero leaves a value unchanged, or using a zero digit as a placeholder in 305.";
    edu:partOf :IntegerArithmetic.
